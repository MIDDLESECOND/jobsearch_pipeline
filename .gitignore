# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ---- Editor / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Local Claude Code config (machine-specific) ----
.claude/settings.local.json
.claude/launch.json
# Personal workflow skills (reference private local paths; not part of the public tool)
.claude/skills/

# Deepdive batch state (last-batch stamp + local calibration; maintained by the skill)
.deepdive_state.json

# ---- Secrets ----
.env
*.key

# ---- Personal data (KEPT LOCAL — ship the *.example.* templates instead) ----
# Real config / profile / guide are private; committed counterparts are the
# sanitized *.example.* files below.
config.yaml
profile.md
evaluation_guide.md
filters.yaml

# ---- Generated / runtime data (third-party scraped content, run output) ----
jobs.db
*.db
# SQLite sidecars (WAL mode: -wal/-shm; rollback journal: -journal)
*.db-wal
*.db-shm
*.db-journal
logs/
reports/
application_materials/
backups/
# Validation-script run outputs (real postings + personal eval notes) — every
# script under tests/validation/ writes into results/, never the repo root
tests/validation/results/
# Belt-and-suspenders: the same files BY NAME at any path, so a copy that lands
# outside results/ (stale checkout/stash, hand-copy, backup restore) stays
# uncommittable in this public repo
compare_results*.json
arbitration_*.json
stratified_results*.json
followup_results*.json
# Local-only data companions for the public validation scripts (name real postings,
# or — for the guide variants a probe compares — carry the private profile/judgment text)
tests/validation/*.local.json
tests/validation/*.local.md

# ---- Local validation tools (read the private jobs.db; name real search targets) ----
tests/validation/investigate_adzuna_churn.py

# Make sure the shipped example templates are never accidentally ignored
!config.example.yaml
!profile.example.md
!evaluation_guide.example.md
!filters.example.yaml

# ignore resume_variant folder
docs/resume_variant/
